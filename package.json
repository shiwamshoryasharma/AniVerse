{
  "name": "aniverse",
  "productName": "AniVerse",
  "version": "1.5.8",
  "private": true,
  "description": "Desktop anime hub: AniList-powered browsing, isolated source sessions, custom HLS/DASH/MP4 player and AniList/MAL sync.",
  "author": {
    "name": "Shiwam Shorya Sharma",
    "url": "https://github.com/shiwamshoryasharma"
  },
  "homepage": "https://github.com/shiwamshoryasharma/AniVerse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiwamshoryasharma/AniVerse.git"
  },
  "bugs": {
    "url": "https://github.com/shiwamshoryasharma/AniVerse/issues"
  },
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "lint": "oxlint app electron frontend/src",
    "test": "vitest run --config test/vitest.config.ts",
    "test:e2e": "node test/e2e/smoke.mjs",
    "test:live": "node test/e2e/sources.mjs",
    "test:sites": "node test/e2e/site-survey.mjs",
    "start": "electron .",
    "dist": "npm run build && electron scripts/make-installer-art.cjs && electron-builder --win --config electron-builder.yml",
    "dist:installer": "npm run build && electron scripts/make-installer-art.cjs && electron-builder --win nsis --config electron-builder.yml",
    "dist:signed": "npm run build && electron scripts/make-installer-art.cjs && node scripts/dist-signed.mjs",
    "release": "node scripts/release.mjs",
    "test:update": "node test/e2e/updater.mjs",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "media:prepare": "node scripts/prepare-media.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-updater": "6.8.9",
    "multicast-dns": "^7.2.5",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@fontsource-variable/inter": "^5.2.8",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/react-query": "^5.104.5",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "anime4k.js": "1.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dashjs": "^5.2.1",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.61.0",
    "oxlint": "^1.88.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
