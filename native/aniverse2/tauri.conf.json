{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniVerse2",
  "version": "3.0.5",
  "identifier": "app.aniverse2.desktop",
  "build": {
    "frontendDist": "../../dist/aniverse2"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "desktop-local"
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' ipc: https://ipc.localhost http://ipc.localhost https://localmedia.localhost; media-src 'self' blob: https://localmedia.localhost; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "resources": ["../../assets/aniverse2/adblock-MPL-2.0.txt"],
    "icon": [
      "../../assets/aniverse2/aniverse2.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/migration.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFNTNDRTJBMTcwRkEyMEEKUldRS29nOFhLczVUSGd1N2J4eG10WkRlSFVqT25UajljM3BoVmVkdG9CNkQ0U3BSOW5Bc3kzQlYK",
      "endpoints": [
        "https://raw.githubusercontent.com/shiwamshoryasharma/AniVerse/codex/aniverse2-windows-updates/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
